# ---------- Core ----------
# "mock" = built-in sample data (demo/dev).  "zoho" = live Zoho CRM.
DATA_SOURCE=mock
# "demo" = pick-a-user login (never for live data).  "zoho" = Sign in with Zoho.
AUTH_MODE=demo
# 32+ random characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false

# ---------- Zoho CRM (needed when DATA_SOURCE=zoho or AUTH_MODE=zoho) ----------
# Data centre of ATPL's Zoho account: in (zoho.in) | com | eu | au
ZOHO_DC=in
# Use Zoho CRM sandbox API host instead of production
ZOHO_SANDBOX=false
# Optional CRM API base URL override
ZOHO_API_BASE_URL=
# DATA access (Self Client) - see docs/SETUP.md step 2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# STAFF SIGN-IN (Server-based client) - see docs/SETUP.md step 1
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Zoho API Console
ZOHO_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback
# CRM user id that should own un-assigned (fresh) leads, e.g. the calling-team lead
ZOHO_QUEUE_OWNER_ID=
# Safety cap on how many leads are read per refresh (200 per Zoho API page)
ZOHO_MAX_LEADS=1000
