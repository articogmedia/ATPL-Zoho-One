# ---------- Core ----------
# "mock" = built-in sample data (demo/dev).  "zoho" = live Zoho CRM.
DATA_SOURCE=mock
# "demo" = pick-a-user login (never for live data).  "zoho" = Sign in with Zoho.
AUTH_MODE=demo
# 32+ random characters. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_INACTIVITY_MINUTES=30
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false
# Enable the pick-a-user demo buttons. Keep false outside local demos.
ALLOW_DEMO_LOGIN=false
# Static portal login passwords (read at runtime; never commit values).
ATPL_RESHMA_PASSWORD=
ATPL_PAVAN_PASSWORD=
ATPL_SAIKIRAN_PASSWORD=
ATPL_CALLING_USERNAME=
ATPL_CALLING_PASSWORD=
ATPL_CALLING_NAME=Calling Team
ATPL_CALLING_EMAIL=
ATPL_CALLING_ZOHO_USER_ID=
NOT_RESPONSIVE_ATTEMPTS=3
# Portal emails used to resolve users in the connected Zoho org.
ATPL_RESHMA_EMAIL=
ATPL_PAVAN_EMAIL=
ATPL_SAIKIRAN_EMAIL=
ATPL_RESHMA_ZOHO_USER_ID=
ATPL_PAVAN_ZOHO_USER_ID=
ATPL_SAIKIRAN_ZOHO_USER_ID=

# Optional non-secret quotation company text overrides (must be NEXT_PUBLIC for the browser preview).
NEXT_PUBLIC_ATPL_COMPANY_NAME=
NEXT_PUBLIC_ATPL_COMPANY_ADDRESS=
NEXT_PUBLIC_ATPL_COMPANY_CONTACT=
NEXT_PUBLIC_ATPL_COMPANY_SIGNATORY=
NEXT_PUBLIC_ATPL_COMPANY_PHONES=
NEXT_PUBLIC_ATPL_COMPANY_GSTIN=
NEXT_PUBLIC_ATPL_OFFER_SUBJECT=
NEXT_PUBLIC_ATPL_OFFER_ENQUIRY=
NEXT_PUBLIC_ATPL_OFFER_PART_A_TITLE=
NEXT_PUBLIC_ATPL_OFFER_PART_B_TITLE=
NEXT_PUBLIC_ATPL_OFFER_PART_A_GST_TEXT=
NEXT_PUBLIC_ATPL_OFFER_PART_B_GST_TEXT=
NEXT_PUBLIC_ATPL_OFFER_NOTE=
NEXT_PUBLIC_ATPL_OFFER_EXCLUDED=
NEXT_PUBLIC_ATPL_OFFER_VALIDITY=
NEXT_PUBLIC_ATPL_OFFER_TAXES=
NEXT_PUBLIC_ATPL_OFFER_DELIVERY=
NEXT_PUBLIC_ATPL_OFFER_PAYMENT_TERMS=
NEXT_PUBLIC_ATPL_OFFER_PAYMENT_CONTINUATION=
NEXT_PUBLIC_ATPL_OFFER_CLOSING=
NEXT_PUBLIC_ATPL_OFFER_THANKS=
NEXT_PUBLIC_ATPL_OFFER_SIGNING=

# ---------- Zoho CRM (needed when DATA_SOURCE=zoho or AUTH_MODE=zoho) ----------
# Data centre of ATPL's Zoho account: in (zoho.in) | com | eu | au
ZOHO_DC=in
# Use Zoho CRM sandbox API host instead of production
ZOHO_SANDBOX=false
# Explicit roles, "email:Role,email:Role", wins over role/profile name matching
ZOHO_ROLE_OVERRIDES=
# Optional CRM API base URL override
ZOHO_API_BASE_URL=
# Optional explicit hosts; if set, they must use HTTPS and match ZOHO_DC (.in, .com, .eu, or .com.au).
# ZOHO_API_DOMAIN=www.zohoapis.in
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional CRM web URL base, e.g. https://crmsandbox.zoho.in/crm/<sandbox-org>
ZOHO_CRM_WEB_BASE=
# DATA access (Self Client) - see docs/SETUP.md step 2
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Required in production for shared OAuth token/cache state across Vercel instances.
# Create an Upstash Redis database and set its REST URL/token in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob token used to publish quotation PDFs for WhatsApp links.
BLOB_READ_WRITE_TOKEN=
# Quotation email delivery. Keep disabled until the provider is configured.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
RESEND_API_KEY=
# STAFF SIGN-IN (Server-based client) - see docs/SETUP.md step 1
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Zoho API Console
ZOHO_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback
# CRM user id that should own un-assigned (fresh) leads, e.g. the calling-team lead
ZOHO_QUEUE_OWNER_ID=
ZOHO_WEBHOOK_SECRET=
# Optional Zoho API name for the custom Site Visits module
ZOHO_SITE_VISITS_MODULE=
# Safety cap on how many leads are read per refresh (200 per Zoho API page)
ZOHO_MAX_LEADS=5000
