diff --git a/src/components/LoadProblem.tsx b/src/components/LoadProblem.tsx
new file mode 100644
index 0000000..630b974
--- /dev/null
+++ b/src/components/LoadProblem.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { useTransition } from "react";
+import { useRouter } from "next/navigation";
+import { RotateCw } from "lucide-react";
+import { Button } from "@/components/ui/button";
+
+export function LoadProblem({ summary, hint, reference }: { summary: string; hint?: string; reference?: string }) {
+  const router = useRouter();
+  const [pending, startTransition] = useTransition();
+  return (
+    <section role="alert" className="rounded-xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-100">
+      <h2 className="font-semibold">{summary}</h2>
+      {hint && <p className="mt-1 text-sm">{hint}</p>}
+      {reference && <p className="mt-1 text-xs opacity-80">Reference: <span className="font-mono">{reference}</span></p>}
+      <Button type="button" variant="outline" className="mt-4" disabled={pending} onClick={() => startTransition(() => router.refresh())}>
+        <RotateCw className={`h-4 w-4 ${pending ? "animate-spin" : ""}`} />Retry
+      </Button>
+    </section>
+  );
+}
diff --git a/src/components/RouteError.tsx b/src/components/RouteError.tsx
new file mode 100644
index 0000000..0d5332f
--- /dev/null
+++ b/src/components/RouteError.tsx
@@ -0,0 +1,27 @@
+"use client";
+
+import Link from "next/link";
+import { useEffect } from "react";
+import { Button } from "@/components/ui/button";
+
+export function RouteError({ error, reset, title = "This page could not load" }: {
+  error: Error & { digest?: string };
+  reset: () => void;
+  title?: string;
+}) {
+  useEffect(() => {
+    console.error("[route-error]", { digest: error.digest, message: error.message });
+  }, [error]);
+
+  return (
+    <main className="mx-auto flex min-h-[50vh] max-w-xl flex-col items-center justify-center px-6 text-center" role="alert">
+      <h1 className="text-2xl font-semibold text-foreground">{title}</h1>
+      <p className="mt-2 text-muted-foreground">Please try again. Your work in Zoho CRM has not been removed.</p>
+      {error.digest && <p className="mt-2 text-xs text-muted-foreground">Reference: <span className="font-mono">{error.digest}</span></p>}
+      <div className="mt-6 flex flex-wrap justify-center gap-2">
+        <Button type="button" onClick={reset}>Try again</Button>
+        <Button asChild variant="outline"><Link href="/home">Go to Home</Link></Button>
+      </div>
+    </main>
+  );
+}
